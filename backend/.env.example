# Copy to backend/.env and fill in. Never commit backend/.env.

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=jugnu

# --- Supabase (Google login only; app data stays in PostgreSQL) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# The sb_publishable_... key. Never put an sb_secret_... key here.
SUPABASE_PUBLISHABLE_KEY=

# --- Demo login (local development only) ---
DEMO_LOGIN=false
# Required when DEMO_LOGIN=true. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_JWT_SECRET=

# --- AI chat ---
# openrouter = real AI (needs OPENROUTER_API_KEY); demo = scripted replies, no key needed
AI_MODE=openrouter
OPENROUTER_API_KEY=
INTAKE_CHAT_MODEL=openrouter/free
INTAKE_EXTRACT_MODEL=openrouter/free
